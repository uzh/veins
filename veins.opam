# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Database connection pooling and migration library for OCaml"
description:
  "Veins provides a database connection pooling library with support for MariaDB and PostgreSQL via functors. It includes migration handling with up/down tracking, transaction management with setup/cleanup hooks, auto-reconnect on connection drop, and a clean label-based interface. The veins-gen tool generates migration file boilerplate."
maintainer: ["Econ IT <it@econ.uzh.ch>"]
authors: ["Department of Economics, University of Zurich"]
license: "MIT"
homepage: "https://github.com/uzh/veins"
bug-reports: "https://github.com/uzh/veins"
depends: [
  "alcotest" {with-test & >= "1.7.0"}
  "alcotest-lwt" {with-test & >= "1.7.0"}
  "caqti" {>= "2.1.0"}
  "caqti-driver-mariadb" {with-test & >= "2.1.0"}
  "caqti-driver-postgresql" {with-test & >= "2.1.0"}
  "caqti-lwt" {>= "2.1.0"}
  "containers" {>= "3.13.0"}
  "dune" {>= "3.17" & >= "3.17"}
  "fmt" {>= "0.9.0"}
  "logs" {>= "0.7.0"}
  "lwt" {>= "5.7.0"}
  "lwt_ppx" {>= "2.1.0"}
  "ocaml" {>= "5.0.0"}
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {>= "0.18.0" & (with-dev-setup | with-test)}
  "ptime" {>= "1.1.0"}
  "uuidm" {>= "0.9.7"}
  "uri" {>= "4.4.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/uzh/veins.git"
